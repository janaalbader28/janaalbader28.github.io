{%- comment -%}
  selected_papers.liquid
  Shows a 3-card preview of projects from the _projects collection.
  - Uses project.img (or project.thumbnail) as the card image
  - Uses project.excerpt (or first paragraph of content) as description
  - Link opens the project's page
{%- endcomment -%}
<div class="papers-list">

  {% assign all_projects = site.projects | sort: "importance" | reverse %}
  {% assign preview = all_projects | where_exp: "p", "p.importance != nil" | slice: 0, 3 %}

  {% for project in preview %}
  <div class="paper-row">

    {% assign thumb = project.img | default: project.thumbnail %}
    <div class="paper-thumb">
      <img src="{{ thumb | relative_url }}" alt="{{ project.title }}">
    </div>

    <div class="paper-info">

      <h3 class="paper-title">{{ project.title }}</h3>

      {% if project.excerpt %}
        <p class="paper-desc">{{ project.excerpt }}</p>
      {% else %}
        {% capture intro %}{{ project.content | strip_html | truncate: 150 }}{% endcapture %}
        <p class="paper-desc">{{ intro }}</p>
      {% endif %}

      <div class="paper-buttons">
        {% if project.website %}<a class="paper-btn" href="{{ project.website }}" target="_blank">Website</a>{% endif %}
        {% if project.demo %}<a class="paper-btn" href="{{ project.demo }}" target="_blank">Demo</a>{% endif %}
        {% if project.slides %}<a class="paper-btn" href="{{ project.slides }}" target="_blank">Slides</a>{% endif %}
        {% if project.github %}<a class="paper-btn" href="{{ project.github }}" target="_blank">GitHub</a>{% endif %}
      </div>

    </div>
  </div>
  {% endfor %}

</div>

