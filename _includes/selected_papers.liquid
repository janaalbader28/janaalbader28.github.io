<div class="publications">

  {% assign all_projects = site.projects | sort: "importance" | reverse %}
  {% assign preview = all_projects | slice: 0, 3 %}  {# show top 3 #}

  {% if preview == empty %}
    <p>No projects found. Make sure your project pages are in <code>_projects/</code>.</p>
  {% else %}
    <div class="projects-preview-row">
      {% for project in preview %}
        <div class="project-row">
          {%- assign thumb = project.img | default: project.thumbnail | default: '/assets/img/default-project.jpg' -%}
          {% if thumb contains 'http://' or thumb contains 'https://' %}
            {% assign image_url = thumb %}
          {% else %}
            {% assign image_url = thumb | relative_url %}
          {% endif %}

          <div class="project-image" style="background-image: url('{{ image_url }}');"></div>

          <div class="project-info">
            <h3 class="project-title">{{ project.title }}</h3>

            {% if project.excerpt %}
              <p class="project-excerpt">{{ project.excerpt }}</p>
            {% else %}
              {% capture intro %}{{ project.content | strip_html | truncate: 200 }}{% endcapture %}
              <p class="project-excerpt">{{ intro }}</p>
            {% endif %}

            <div class="project-buttons">
              {% if project.demo %}<a href="{{ project.demo }}" target="_blank" class="btn">Demo</a>{% endif %}
              {% if project.github %}<a href="{{ project.github }}" target="_blank" class="btn">GitHub</a>{% endif %}
              {% if project.website %}<a href="{{ project.website }}" target="_blank" class="btn">Website</a>{% endif %}
              <a href="{{ project.url | relative_url }}" class="btn btn-primary">View Project</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
