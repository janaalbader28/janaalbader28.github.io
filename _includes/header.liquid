

<header>
  <!-- Minimal Nav Bar: only brand + theme toggle -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container d-flex align-items-center justify-content-between">

      <!-- Brand: only show when not the home page (keeps your current logic) -->
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter mb-0" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">{{- site.first_name -}}</span>
            {% endif %}
            {% if site.middle_name %}{{- site.middle_name -}}{% endif %}
            {% if site.last_name %}{{- site.last_name -}}{% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% else %}
        <!-- keep the left side empty on homepage for perfect center alignment -->
        <div></div>
      {% endif %}

      <!-- Right: theme toggle only -->
      <div class="nav-controls d-flex align-items-center">
        {% if site.enable_darkmode %}
          <button id="light-toggle" class="btn btn-ghost" title="Change theme" aria-label="Toggle theme">
            <i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
            <i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i>
            <i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i>
          </button>
        {% endif %}
      </div>

    </div>
  </nav>

  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar (optional) -->
    <progress id="progress" value="0"></progress>
  {% endif %}
</header>
